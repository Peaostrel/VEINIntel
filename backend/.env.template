# VEIN.intel - Environment Configuration Template

# 1. AI Reasoning Provider (OpenAI or Gemini)
# To use OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
# To use Gemini:
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Bright Data Infrastructure Credentials
# Get your API Token from Bright Data Control Panel -> API Tokens
BRIGHTDATA_API_KEY=your_brightdata_api_token_here

# Bright Data SERP API Zone Name / Credentials
BRIGHTDATA_SERP_ZONE=your_serp_zone_name_here
BRIGHTDATA_SERP_USER=brd-customer-xxxx-zone-serp
BRIGHTDATA_SERP_PASS=your_serp_password_here

# Bright Data Web Unlocker proxy credentials
BRIGHTDATA_UNLOCKER_PROXY=http://brd-customer-xxxx-zone-unlocker:password@brd.superproxy.io:22225

# 3. Application Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True
